<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pendaftaran Karyawan - Absensi WFA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            background-image: 
                radial-gradient(at 0% 0%, rgba(13, 110, 253, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(13, 110, 253, 0.05) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px 0;
        }
        .register-card {
            width: 100%;
            max-width: 450px;
            border: none;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(13, 110, 253, 0.08);
        }
    </style>
</head>
<body>

    <div class="card register-card p-4 bg-white">
        <div class="text-center mb-4">
            <div class="text-primary fs-1 mb-2"><i class="bi bi-person-plus-fill"></i></div>
            <h4 class="fw-bold text-dark mb-1">ABSENSI WFA</h4>
            <p class="text-muted small">Daftar akun baru untuk sistem absensi Anda</p>
        </div>

        <form action="/register" method="POST">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Nama Lengkap</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                    <input type="text" name="nama" class="form-control" placeholder="Masukkan nama lengkap" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Alamat Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                    <input type="email" name="email" class="form-control" placeholder="nama@perusahaan.com" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="Masukkan password" minlength="6" required>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Daftar Sebagai</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-person-gear"></i></span>
                    <select id="roleSelect" name="role" class="form-select" required>
                        <option value="" disabled selected>Pilih hak akses...</option>
                        <option value="karyawan">Karyawan</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
            </div>

            <!-- OPSI A: INPUTAN DROP-DOWN SHIFT KERJA -->
            <div class="mb-4" id="shiftGroup" style="display: none;">
                <label class="form-label small fw-semibold text-secondary">Pilih Shift Kerja</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-clock-history"></i></span>
                    <select name="shift" class="form-select">
                        <option value="">-- Otomatis Pilihkan Shift (Acak) --</option>
                        <option value="Pagi">Shift Pagi (08:00 - 13:00)</option>
                        <option value="Siang">Shift Siang (13:00 - 21:00)</option>
                        <option value="Malam">Shift Malam (21:00 - 05:00)</option>
                    </select>
                </div>
                <small class="text-muted" style="font-size: 0.75rem;">*Kosongkan jika ingin sistem menentukan shift secara acak.</small>
            </div>

            <button type="submit" id="submitBtn" class="btn btn-primary w-100 fw-semibold py-2 shadow-sm">
                <i class="bi bi-person-check me-1"></i> Daftar Akun
            </button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
            <p class="text-muted small mb-0">Sudah punya akun? <a href="/login" class="text-decoration-none fw-semibold">Masuk di sini</a></p>
        </div>
    </div>

    <script>
        const roleSelect = document.getElementById('roleSelect');
        const submitBtn = document.getElementById('submitBtn');
        const shiftGroup = document.getElementById('shiftGroup');

        roleSelect.addEventListener('change', function() {
            if (this.value === 'admin') {
                // Sembunyikan input shift jika memilih Admin
                shiftGroup.style.display = 'none';
                submitBtn.innerHTML = '<i class="bi bi-shield-lock me-1"></i> Daftar Sebagai Admin';
            } else if (this.value === 'karyawan') {
                // Tampilkan input shift jika memilih Karyawan
                shiftGroup.style.display = 'block';
                submitBtn.innerHTML = '<i class="bi bi-qr-code me-1"></i> Daftar & Buat QR Code';
            }
        });
    </script>
</body>
</html>