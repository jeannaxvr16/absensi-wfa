<%- include('partials/karyawan-head', { title: 'Scan QR Presensi - WFA Attendance' }) %>
<%- include('partials/karyawan-sidebar', { active: 'scan', user: user }) %>

<div class="wfa-page-title"><h1>Scan QR Presensi</h1><p>Gunakan QR Dinamis dari Admin untuk mencatat presensi WFA.</p></div>
<div class="wfa-scan-layout">
  <section class="wfa-card">
    <div class="wfa-card-head"><h2><i class="bi bi-qr-code-scan text-primary me-2"></i>Pindai QR Absensi</h2><span>QR Dinamis</span></div>
    <div class="wfa-reader-wrap"><div id="reader"></div></div>
    <div class="wfa-upload mt-3">
      <div class="fw-bold" style="font-size:12px">Tidak sedang memegang layar Admin?</div>
      <div class="text-muted mt-1 mb-3" style="font-size:10px">Simpan gambar QR Dinamis dari Admin, lalu pilih gambarnya di sini.</div>
      <label for="qr-file-input" class="wfa-btn wfa-btn-light" style="display:inline-block;cursor:pointer"><i class="bi bi-image me-1"></i> Pilih Gambar QR</label>
      <input id="qr-file-input" type="file" accept="image/*" hidden>
    </div>
    <div id="status-alert" class="alert d-none mt-3" role="alert"><span id="status-icon" class="me-2"></span><span id="status-text">Memproses...</span></div>
    <div class="mt-3 p-3 rounded-3" style="background:#f6f9ff;border:1px solid var(--wfa-border);font-size:10px;color:var(--wfa-muted)">
      <div class="fw-bold mb-2" style="font-size:11px;color:var(--wfa-text)"><i class="bi bi-shield-check text-primary me-1"></i>Yang perlu disiapkan</div>
      <ul class="mb-0 ps-3"><li>Login menggunakan akun karyawan sendiri.</li><li>Izinkan kamera jika menggunakan scan langsung.</li><li>Izinkan lokasi/GPS agar posisi presensi dapat diperiksa.</li><li>QR registrasi karyawan tidak digunakan untuk presensi.</li></ul>
    </div>
  </section>
</div>

<script src="https://unpkg.com/html5-qrcode"></script>
<script>
const alertBox = document.getElementById('status-alert');
const alertText = document.getElementById('status-text');
const alertIcon = document.getElementById('status-icon');
const qrFileInput = document.getElementById('qr-file-input');
let sudahScan = false;
let scannerRunning = false;
const html5QrCode = new Html5Qrcode('reader');

function updateUIStatus(type, text, iconClass) {
  alertBox.className = `alert alert-${type} d-flex mt-3 align-items-center fw-semibold`;
  alertText.innerText = text;
  alertIcon.className = `bi ${iconClass} me-2 fs-5`;
}

async function prosesHasilScan(decodedText) {
  if (sudahScan) return;
  sudahScan = true;
  console.log('QR TERBACA:', decodedText);

  if (!String(decodedText).startsWith('WFA_DYNAMIC:')) {
    updateUIStatus('danger', 'QR ini bukan QR Dinamis absensi. Gunakan QR yang dibuat oleh Admin.', 'bi-x-circle-fill');
    sudahScan = false;
    return;
  }

  try { if (scannerRunning) { await html5QrCode.stop(); scannerRunning = false; } } catch (err) { console.log(err); }
  updateUIStatus('warning', 'QR terbaca! Sedang mengambil lokasi GPS Anda...', 'bi-geo-alt-fill');

  if (!navigator.geolocation) {
    updateUIStatus('danger', 'Browser tidak mendukung Geolocation API.', 'bi-geo-fill');
    sudahScan = false; return;
  }

  navigator.geolocation.getCurrentPosition(async position => {
    const latitude = position.coords.latitude;
    const longitude = position.coords.longitude;
    updateUIStatus('info', 'Lokasi berhasil diperoleh. Memvalidasi presensi...', 'bi-cloud-arrow-up-fill');
    try {
      const response = await fetch('/attendance', {
        method:'POST', headers:{'Content-Type':'application/json'}, credentials:'same-origin',
        body: JSON.stringify({ dynamic_token: decodedText, latitude, longitude })
      });
      let result = {};
      try { result = await response.json(); } catch (_) {}
      if (response.ok) {
        const messageText = result.message || 'Absensi berhasil dicatat.';
        const late = (result.status || '').toLowerCase().includes('terlambat') || messageText.toLowerCase().includes('terlambat');
        updateUIStatus(late ? 'warning' : 'success', messageText, late ? 'bi-exclamation-octagon-fill' : 'bi-check-circle-fill');
        setTimeout(() => window.location.href = '/dashboard', 1800);
      } else {
        updateUIStatus('danger', result.message || 'Gagal melakukan absensi.', 'bi-x-circle-fill');
        sudahScan = false;
      }
    } catch (error) {
      console.error(error);
      updateUIStatus('danger', 'Gagal terhubung ke server.', 'bi-exclamation-triangle-fill');
      sudahScan = false;
    }
  }, error => {
    let msg = 'GPS harus diaktifkan dan diizinkan untuk melakukan absensi.';
    if (error.code === 1) msg = 'Izin lokasi ditolak. Silakan izinkan akses lokasi pada browser.';
    else if (error.code === 2) msg = 'Lokasi tidak dapat ditemukan. Pastikan GPS perangkat aktif.';
    else if (error.code === 3) msg = 'Pengambilan lokasi terlalu lama. Coba lagi.';
    updateUIStatus('danger', msg, 'bi-geo-fill');
    sudahScan = false;
  }, { enableHighAccuracy:true, timeout:15000, maximumAge:0 });
}

function onScanSuccess(decodedText) { prosesHasilScan(decodedText); }

html5QrCode.start({facingMode:'environment'}, {fps:10, qrbox:250}, onScanSuccess)
  .then(() => scannerRunning = true)
  .catch(err => updateUIStatus('danger', 'Kamera gagal diakses. Anda tetap bisa memilih gambar QR dari file.', 'bi-camera-video-off-fill'));

qrFileInput.addEventListener('change', async function() {
  const file = this.files[0];
  if (!file) return;
  sudahScan = false;
  try {
    if (scannerRunning) {
      try { await html5QrCode.stop(); } catch (_) {}
      scannerRunning = false;
    }
    const fileScanner = new Html5Qrcode('reader');
    updateUIStatus('info', 'Membaca QR dari gambar...', 'bi-image');
    const result = await fileScanner.scanFile(file, true);
    await prosesHasilScan(result);
  } catch (error) {
    console.error(error);
    updateUIStatus('danger', 'QR Code tidak dapat dibaca dari gambar.', 'bi-image-alt');
    sudahScan = false;
  } finally { this.value = ''; }
});
</script>

<%- include('partials/karyawan-foot') %>
