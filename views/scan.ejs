<!DOCTYPE html>

<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scan QR Absensi - WFA</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f4f6f9;
    }

    .scan-container {
        max-width: 600px;
        margin: 40px auto;
    }

    .card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }

    #reader {
        width: 100%;
        border-radius: 12px;
        overflow: hidden;
        border: 2px dashed #0d6efd !important;
        background-color: #000;
    }
</style>

</head>

<body>

<div class="container px-3">
    <div class="scan-container">

    <div class="mb-3">
        <a href="javascript:history.back()"
           class="text-decoration-none text-secondary fw-semibold">
            <i class="bi bi-arrow-left me-1"></i>
            Kembali ke Dashboard
        </a>
    </div>

    <div class="card p-4 bg-white">

        <div class="text-center mb-4">

            <h4 class="fw-bold text-dark mb-1">
                <i class="bi bi-qr-code-scan text-primary me-2"></i>
                Pindai QR Absensi
            </h4>

            <p class="text-muted small">
                Arahkan kamera perangkat Anda tepat ke QR Code absensi
                untuk mencatat kehadiran WFA.
            </p>

        </div>

        <div id="reader"></div>

        <div id="status-alert"
             class="alert d-none mt-3 align-items-center"
             role="alert">

            <div id="status-icon" class="me-2 fs-5"></div>

            <div id="status-text">
                Memproses...
            </div>

        </div>

        <div class="mt-4 p-3 bg-light rounded-3">

            <h6 class="fw-bold text-dark mb-2"
                style="font-size: 0.9rem;">

                <i class="bi bi-shield-check text-warning me-1"></i>
                Izin Akses Perangkat:

            </h6>

            <ul class="text-muted small mb-0 ps-3">

                <li>
                    Pastikan kamu klik
                    <strong>Allow / Izinkan</strong>
                    saat browser meminta akses Kamera.
                </li>

                <li>
                    GPS perangkat wajib aktif dan diizinkan
                    agar koordinat presensi dapat dicatat.
                </li>

            </ul>

        </div>

    </div>

</div>

</div>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>

const alertBox = document.getElementById('status-alert');
const alertText = document.getElementById('status-text');
const alertIcon = document.getElementById('status-icon');

let sudahScan = false;


function updateUIStatus(type, text, iconClass) {

    alertBox.className =
        `alert alert-${type} d-flex mt-3 align-items-center fw-semibold`;

    alertText.innerText = text;

    alertIcon.className =
        `bi ${iconClass} me-2 fs-5`;
}


// ======================================================
// PROSES HASIL SCAN
// ======================================================

async function onScanSuccess(decodedText) {

    // Mencegah scanner mengirim request berkali-kali
    if (sudahScan) {
        return;
    }

    sudahScan = true;


    console.log('QR TERBACA:', decodedText);


    // ======================================================
    // HENTIKAN KAMERA
    // ======================================================

    try {

        await html5QrCode.stop();

    } catch (err) {

        console.log(
            'Kamera sudah berhenti:',
            err
        );

    }


    updateUIStatus(
        'warning',
        'QR terbaca! Sedang mengambil lokasi GPS Anda...',
        'bi-geo-alt-fill'
    );


    // ======================================================
    // CEK GEOLOCATION
    // ======================================================

    if (!navigator.geolocation) {

        updateUIStatus(
            'danger',
            'Browser tidak mendukung Geolocation API.',
            'bi-geo-fill'
        );

        sudahScan = false;

        return;
    }


    // ======================================================
    // AMBIL LOKASI
    // ======================================================

    navigator.geolocation.getCurrentPosition(

        async (position) => {

            const latitude =
                position.coords.latitude;

            const longitude =
                position.coords.longitude;


            console.log(
                'GPS:',
                latitude,
                longitude
            );


            updateUIStatus(
                'info',
                'Lokasi berhasil diperoleh. Mengirim data absensi...',
                'bi-cloud-arrow-up-fill'
            );


            try {

                // ==================================================
                // CEK JENIS QR
                // ==================================================

                const isDynamicQR =
                    decodedText.startsWith('WFA_DYNAMIC:');


                let requestBody;


                // ==================================================
                // QR DINAMIS ADMIN
                // ==================================================

                if (isDynamicQR) {

                    /*
                     * PENTING:
                     *
                     * Jangan buang "WFA_DYNAMIC:".
                     *
                     * Backend attendanceRoutes.js
                     * melakukan pengecekan:
                     *
                     * dynamic_token.startsWith('WFA_DYNAMIC:')
                     *
                     */

                    requestBody = {

                        dynamic_token:
                            decodedText,

                        latitude:
                            latitude,

                        longitude:
                            longitude
                    };

                }


                // ==================================================
                // QR PERSONAL KARYAWAN
                // ==================================================

                else {

                    requestBody = {

                        qr_token:
                            decodedText,

                        latitude:
                            latitude,

                        longitude:
                            longitude
                    };

                }


                console.log(
                    'DATA YANG DIKIRIM:',
                    requestBody
                );


                // ==================================================
                // KIRIM KE BACKEND
                // ==================================================

                const response =
                    await fetch(
                        '/attendance',
                        {

                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json'
                            },

                            credentials: 'same-origin',

                            body:
                                JSON.stringify(
                                    requestBody
                                )
                        }
                    );


                // ==================================================
                // BACA RESPONSE
                // ==================================================

                let result;

                try {

                    result =
                        await response.json();

                } catch (jsonError) {

                    result = {
                        message:
                            'Response server tidak valid.'
                    };

                }


                console.log(
                    'RESPONSE SERVER:',
                    result
                );


                // ==================================================
                // BERHASIL
                // ==================================================

                if (response.ok) {

                    const messageText =
                        result.message ||
                        'Absensi berhasil dicatat.';


                    const status =
                        result.status || '';


                    const isTerlambat =
                        status
                            .toLowerCase()
                            .includes('terlambat') ||
                        messageText
                            .toLowerCase()
                            .includes('terlambat');


                    if (isTerlambat) {

                        updateUIStatus(
                            'danger',
                            messageText,
                            'bi-exclamation-octagon-fill'
                        );

                    } else {

                        updateUIStatus(
                            'success',
                            messageText,
                            'bi-check-circle-fill'
                        );

                    }


                    // ==================================================
                    // KEMBALI DASHBOARD
                    // ==================================================

                    setTimeout(() => {

                        window.location.href =
                            '/dashboard';

                    }, 2000);

                }


                // ==================================================
                // GAGAL
                // ==================================================

                else {

                    updateUIStatus(
                        'danger',
                        result.message ||
                        'Gagal melakukan absensi.',
                        'bi-x-circle-fill'
                    );


                    sudahScan = false;

                }

            }

            catch (error) {

                console.error(
                    'Error fetch attendance:',
                    error
                );


                updateUIStatus(
                    'danger',
                    'Gagal terhubung ke server.',
                    'bi-exclamation-triangle-fill'
                );


                sudahScan = false;

            }

        },


        // ======================================================
        // GPS ERROR
        // ======================================================

        (error) => {

            console.error(
                'GPS ERROR:',
                error
            );


            let pesanGPS =
                'GPS harus diaktifkan dan diizinkan untuk melakukan absensi.';


            if (error.code === 1) {

                pesanGPS =
                    'Izin lokasi ditolak. Silakan izinkan akses lokasi pada browser.';

            }

            else if (error.code === 2) {

                pesanGPS =
                    'Lokasi tidak dapat ditemukan. Pastikan GPS perangkat aktif.';

            }

            else if (error.code === 3) {

                pesanGPS =
                    'Pengambilan lokasi terlalu lama. Coba lagi.';

            }


            updateUIStatus(
                'danger',
                pesanGPS,
                'bi-geo-fill'
            );


            sudahScan = false;

        },


        // ======================================================
        // OPSI GPS
        // ======================================================

        {
            enableHighAccuracy: true,
            timeout: 15000,
            maximumAge: 0
        }

    );

}


// ======================================================
// INISIALISASI SCANNER
// ======================================================

const html5QrCode =
    new Html5Qrcode('reader');


html5QrCode.start(

    {
        facingMode: 'environment'
    },

    {
        fps: 10,
        qrbox: 250
    },

    onScanSuccess

).catch(err => {

    console.error(
        'KAMERA ERROR:',
        err
    );


    updateUIStatus(
        'danger',
        'Kamera gagal diakses. Pastikan kamera telah diizinkan dan tidak sedang digunakan aplikasi lain.',
        'bi-camera-video-off-fill'
    );

});

</script>

</body>
</html>