<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scan QR Absensi - WFA</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
        }
        .scan-container {
            max-width: 600px;
            margin: 40px auto;
        }
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }
        #reader {
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            border: 2px dashed #0d6efd !important;
            background-color: #000;
        }
    </style>
</head>
<body>

    <div class="container px-3">
        <div class="scan-container">
            
            <div class="mb-3">
                <a href="javascript:history.back()" class="text-decoration-none text-secondary fw-semibold">
                    <i class="bi bi-arrow-left me-1"></i> Kembali ke Dashboard
                </a>
            </div>

            <div class="card p-4 bg-white">
                <div class="text-center mb-4">
                    <h4 class="fw-bold text-dark mb-1"><i class="bi bi-qr-code-scan text-primary me-2"></i>Pindai QR Absensi</h4>
                    <p class="text-muted small">Arahkan kamera perangkat Anda tepat ke QR Code absensi untuk mencatat kehadiran WFA.</p>
                </div>

                <div id="reader"></div>

                <div id="status-alert" class="alert d-none mt-3 align-items-center" role="alert">
                    <div id="status-icon" class="me-2 fs-5"></div>
                    <div id="status-text">Memproses...</div>
                </div>

                <div class="mt-4 p-3 bg-light rounded-3">
                    <h6 class="fw-bold text-dark mb-2" style="font-size: 0.9rem;"><i class="bi bg-light text-warning me-1"></i> Izin Akses Perangkat:</h6>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Pastikan kamu klik **Allow / Izinkan** saat browser meminta akses Kamera.</li>
                        <li>GPS laptop/HP wajib aktif agar koordinat presensi WFA bisa terpetakan di sistem Admin.</li>
                    </ul>
                </div>
            </div>

        </div>
    </div>

    <script src="https://unpkg.com/html5-qrcode"></script>
    
    <script>
        const alertBox = document.getElementById('status-alert');
        const alertText = document.getElementById('status-text');
        const alertIcon = document.getElementById('status-icon');

        function updateUIStatus(type, text, iconClass) {
            alertBox.className = `alert alert-${type} d-flex mt-3`;
            alertText.innerText = text;
            alertIcon.className = `bi ${iconClass} me-2 fs-5`;
        }

        // Jalankan fungsi sukses milikmu dengan perbaikan penanganan matikan kamera
        function onScanSuccess(decodedText) {
            // Mematikan kamera secara aman (menangani Promise)
            html5QrCode.stop().then(() => {
                updateUIStatus('warning', 'QR Terbaca! Sedang mengunci lokasi GPS Anda...', 'bi-geo-alt-fill');
                
                // Ambil Geolocation GPS
                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const latitude = position.coords.latitude;
                        const longitude = position.coords.longitude;

                        updateUIStatus('info', 'Mengirimkan data absensi ke server...', 'bi-cloud-arrow-up-fill');

                        try {
                            // Hit ke POST router /attendance yang kamu miliki
                            const response = await fetch('/attendance', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    qr_token: decodedText,
                                    latitude: latitude,
                                    longitude: longitude
                                })
                            });

                            const result = await response.json();
                            
                            if (response.ok && result.message === 'Absensi berhasil') {
                                updateUIStatus('success', result.message, 'bi-check-circle-fill');
                                // Kembali ke dashboard setelah sukses dalam waktu 1.5 detik
                                setTimeout(() => {
                                    window.location.href = document.referrer || '/';
                                }, 1500);
                            } else {
                                updateUIStatus('danger', result.message || 'Gagal absen', 'bi-x-circle-fill');
                            }

                        } catch (error) {
                            console.error(error);
                            updateUIStatus('danger', 'Gagal terhubung ke server.', 'bi-exclamation-triangle-fill');
                        }
                    },
                    (error) => {
                        updateUIStatus('danger', 'GPS harus diaktifkan dan diizinkan untuk absensi!', 'bi-geo-fill');
                        console.log(error);
                    }
                );
            }).catch(err => {
                console.error("Gagal menghentikan kamera: ", err);
            });
        }

        // Konfigurasi kamera bawaan kamu
        const html5QrCode = new Html5Qrcode("reader");
        html5QrCode.start(
            { facingMode: "environment" },
            {
                fps: 10,
                qrbox: 250
            },
            onScanSuccess
        ).catch(err => {
            updateUIStatus('danger', 'Kamera gagal diakses. Pastikan tidak dipakai aplikasi lain.', 'bi-camera-video-off-fill');
        });
    </script>
</body>
</html>