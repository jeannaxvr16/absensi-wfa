<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - WFA Absensi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f9;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .reset-card {
            width: 100%;
            max-width: 400px;
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 25px rgba(0,0,0,0.06);
        }
    </style>
</head>
<body>

    <div class="card reset-card p-4 bg-white">
        <div class="text-center mb-4">
            <div class="text-warning fs-1 mb-2"><i class="bi bi-shield-lock"></i></div>
            <h4 class="fw-bold text-dark mb-1">Ubah Password</h4>
            <p class="text-muted small">Masukkan email terdaftar Anda untuk memperbarui password</p>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-<%= type %> py-2 small d-flex align-items-center" role="alert">
                <i class="bi <%= type === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-circle-fill' %> me-2"></i>
                <div><%= message %></div>
            </div>
        <% } %>

        <form action="/forgot-password" method="POST">
            <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">Email Akun Anda</label>
                <input type="email" name="email" class="form-control" placeholder="nama@perusahaan.com" required>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold text-secondary">Password Baru</label>
                <input type="password" name="newPassword" class="form-control" placeholder="••••••••" minlength="6" required>
            </div>
            <button type="submit" class="btn btn-warning w-100 fw-semibold text-dark py-2">Perbarui Password</button>
        </form>

        <div class="text-center mt-4 pt-2 border-top">
            <a href="/login" class="text-decoration-none small fw-semibold"><i class="bi bi-arrow-left"></i> Kembali ke Login</a>
        </div>
    </div>

</body>
</html>