<%- include('partials/karyawan-head', { title: 'Profil Saya - WFA Attendance' }) %>
<%- include('partials/karyawan-sidebar', { active: 'profile', user: user }) %>

<div class="wfa-page-title"><h1>Profil Saya</h1><p>Informasi akun karyawan yang sedang digunakan untuk presensi.</p></div>
<section class="wfa-card wfa-form-card">
  <div class="wfa-profile-head">
    <div class="wfa-profile-avatar"><%= user.nama.charAt(0).toUpperCase() %></div>
    <div><h2 class="mb-1" style="font-size:18px;font-weight:800"><%= user.nama %></h2><p class="mb-0" style="font-size:11px;color:var(--wfa-muted)"><%= user.email %></p></div>
  </div>
  <div class="wfa-detail">
    <div class="wfa-detail-box"><small>Nama Karyawan</small><strong><%= user.nama %></strong></div>
    <div class="wfa-detail-box"><small>Email</small><strong><%= user.email %></strong></div>
    <div class="wfa-detail-box"><small>Role</small><strong>Karyawan</strong></div>
    <div class="wfa-detail-box"><small>Shift Kerja</small><strong><%= user.shift || 'Pagi' %></strong></div>
    <div class="wfa-detail-box"><small>Metode Presensi</small><strong>QR Dinamis + Geolocation</strong></div>
    <div class="wfa-detail-box"><small>Area WFA</small><strong>Radius 100 km</strong></div>
  </div>
  <div class="mt-3 p-3 rounded-3" style="background:#f5f8ff;border:1px solid var(--wfa-border);font-size:11px;color:var(--wfa-muted)">
    <i class="bi bi-shield-check text-primary me-1"></i> Gunakan perangkat yang sudah terdaftar saat login dan pastikan izin lokasi aktif ketika melakukan presensi.
  </div>
</section>

<%- include('partials/karyawan-foot') %>
