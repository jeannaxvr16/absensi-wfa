<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Dinamis Absensi - Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary-green: #00966c;
            --bg-light: #f4f6f9;
            --sidebar-dark: #1e2530;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            color: #232d42;
        }
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            width: 260px;
            background-color: var(--sidebar-dark);
            z-index: 100;
            padding-top: 1rem;
        }
        .brand-logo {
            padding: 0.5rem 1.5rem 1.5rem 1.5rem;
            font-size: 1.35rem;
            font-weight: 700;
            color: #fff;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .brand-icon-wrapper {
            background-color: var(--primary-green);
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
        }
        .sidebar-menu {
            list-style: none;
            padding: 1.5rem 0;
            margin: 0;
        }
        .menu-item a {
            display: flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            color: #a0aec0;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
        }
        .menu-item.active a {
            border-left: 4px solid var(--primary-green);
            background-color: rgba(0, 150, 108, 0.08);
            color: #fff;
            font-weight: 600;
        }
        .main-content {
            margin-left: 260px;
            min-height: 100vh;
            padding: 2rem;
        }
        @keyframes pulse {
            0% { opacity: 0.6; }
            50% { opacity: 1; }
            100% { opacity: 0.6; }
        }
        .animate-pulse {
            animation: pulse 2s infinite;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="brand-logo">
            <div class="brand-icon-wrapper">
                <i class="bi bi-fingerprint text-white fs-5"></i>
            </div>
            <span>Absensi</span>
        </div>
        <ul class="sidebar-menu">
            <li class="menu-item">
                <a href="/admin"><i class="bi bi-grid-1x2 me-2"></i> Dashboard</a>
            </li>
            <li class="menu-item active">
                <a href="/admin/qr-dinamis"><i class="bi bi-qr-code-scan me-2"></i> QR Dinamis</a>
            </li>
            <li class="menu-item">
                <a href="/admin/leaves"><i class="bi bi-calendar2-check"></i> Izin / Cuti</a>
            </li>
        </ul>
    </div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <div class="container-fluid py-2">
            <div class="row">
                
                <!-- Kolom Kiri: Tampilan QR Code Monitor -->
                <div class="col-md-4 text-center mb-4">
                    <div class="card shadow-sm border-0 p-4 bg-white rounded-4">
                        <h5 class="fw-bold mb-3 text-dark">Scan QR Absensi Hari Ini</h5>
                        
                        <div class="d-flex justify-content-center my-3">
                            <!-- Render otomatis QR Code menggunakan API luar berdasarkan data enkripsi hari ini -->
                            <img src="https://api.qrserver.com/v1/create-qr-code/?size=240x240&data=<%= encodeURIComponent(qrData) %>" alt="QR Code" class="img-fluid border p-2 bg-white shadow-sm rounded-3">
                        </div>
                        
                        <span class="badge bg-danger animate-pulse py-2 px-3 mt-2 rounded-pill"><i class="bi bi-broadcast me-1"></i> QR Code Dinamis Aktif</span>
                        <p class="text-muted small mt-3">Minta karyawan melakukan scan langsung melalui aplikasi/dashboard scan mereka.</p>
                    </div>
                </div>

                <!-- Kolom Kanan: Daftar Log Kehadiran Real-time -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0 rounded-4 bg-white overflow-hidden">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-0">
                            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-people-fill text-success me-2"></i>Karyawan Hadir (Hari Ini)</h5>
                            <span class="badge bg-primary px-3 py-2 rounded-pill"><%= attendances.length %> Karyawan</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Nama Karyawan</th>
                                        <th>Email</th>
                                        <th>Waktu Scan</th>
                                        <th class="pe-4 text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (attendances.length > 0) { %>
                                        <% attendances.forEach(absens => { %>
                                            <tr>
                                                <td class="fw-bold text-secondary ps-4"><%= absens.User ? absens.User.nama : 'Tidak Diketahui' %></td>
                                                <td class="text-muted"><%= absens.User ? absens.User.email : '-' %></td>
                                                <td><span class="badge bg-light text-dark px-2.5 py-1.5"><i class="bi bi-clock me-1 text-success"></i> <%= new Date(absens.waktu).toLocaleTimeString('id-ID', {hour: '2-digit', minute:'2-digit'}) %> WIB</span></td>
                                                <td class="pe-4 text-end"><span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">Hadir</span></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-5">
                                                <i class="bi bi-qr-code-scan display-4 d-block mb-3 text-body-tertiary"></i>
                                                Belum ada karyawan yang melakukan absensi hari ini.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>