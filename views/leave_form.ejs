<%- include('partials/karyawan-head', { title: 'Pengajuan Izin / Cuti - WFA Attendance' }) %>
<%- include('partials/karyawan-sidebar', { active: 'leave', currentUser: currentUser }) %>

<div class="wfa-page-title"><h1>Pengajuan Izin / Cuti</h1><p>Ajukan izin, sakit, atau cuti dan pantau status persetujuannya.</p></div>
<section class="wfa-card wfa-form-card">
  <div class="wfa-card-head"><h2><i class="bi bi-calendar-plus text-primary me-2"></i>Form Pengajuan</h2><span>Status awal: Pending</span></div>
  <form action="/leave/store" method="POST">
    <div class="mb-3">
      <label class="wfa-label">Nama Karyawan</label>
      <input type="text" class="form-control wfa-input" value="<%= currentUser.nama %> (<%= currentUser.shift || 'Pagi' %>)" readonly>
      <input type="hidden" name="user_id" value="<%= currentUser.id %>">
    </div>
    <div class="mb-3">
      <label class="wfa-label">Jenis Pengajuan</label>
      <select name="jenis" class="form-select wfa-select" required>
        <option value="Izin">Izin</option><option value="Sakit">Sakit</option><option value="Cuti">Cuti</option>
      </select>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3"><label class="wfa-label">Tanggal Mulai</label><input type="date" name="tanggal_mulai" class="form-control wfa-input" required></div>
      <div class="col-md-6 mb-3"><label class="wfa-label">Tanggal Selesai</label><input type="date" name="tanggal_selesai" class="form-control wfa-input" required></div>
    </div>
    <div class="mb-4"><label class="wfa-label">Alasan Singkat</label><textarea name="alasan" class="form-control wfa-textarea" rows="4" placeholder="Contoh: Demam dan perlu istirahat..." required></textarea></div>
    <div class="d-flex gap-2 justify-content-end"><a href="/dashboard" class="wfa-btn wfa-btn-light">Batal</a><button type="submit" class="wfa-btn wfa-btn-primary"><i class="bi bi-send me-1"></i> Kirim Pengajuan</button></div>
  </form>
</section>

<%- include('partials/karyawan-foot') %>
